# Galen Translation Evaluation - API Configuration
# Copy this file to .env and add your actual API keys

# ============================================
# Required: Translation API Keys
# ============================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key (Gemini)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# GPU use, metrics and parallel calls are set on the command line (python3 pipeline.py --help).
# Optional: the BLEURT-20 checkpoint, if not in mt_eval/models/BLEURT-20
# BLEURT_CHECKPOINT=/path/to/BLEURT-20
