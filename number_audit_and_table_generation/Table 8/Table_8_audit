    print(f"{strat_name:<25} {'Scheme 1':<10} {mix_scheme1:<12.1f} {scheme1_rate:<12.1f} {gap_s1:<10.1f} {expected_gap_s1:<10.1f} {match_gap_s1:<10}")
    
    # Scheme 2 gap
    scheme2_rate, _, _ = calculate_pass_rate(strat_df, 'Final Quality Rating')
