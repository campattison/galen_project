def analyze_text(df, text_name):
    """Analyze error typology for a given text"""
    
    # Total errors (sum of all severity levels)
    total_errors = df['Neutral'].sum() + df['Minor'].sum() + df['Major'].sum() + df['Critical'].sum()
    
    # Number of translations (each passage × model combination)
    n_translations = len(df)
    errors_per_passage = total_errors / n_translations
    
    # Severity counts
    neutral = df['Neutral'].sum()
    minor = df['Minor'].sum()
    major = df['Major'].sum()
    critical = df['Critical'].sum()
    
    # Error types
    terminology = df['Term.: Total'].sum()
    accuracy = df['Acc.: Total'].sum()
    
    # Terminology subtypes
    term_accuracy = df['Term.: Accuracy'].sum()
    term_consistency = df['Term.: Consistency'].sum()
    
    # Accuracy subtypes
    mistranslation = df['Acc.: Mistranslation'].sum()
    overtranslation = df['Acc.: Overtranslation'].sum()
    undertranslation = df['Acc.: Undertranslation'].sum()
    addition = df['Acc.: Addition'].sum()
    omission = df['Acc.: Omission'].sum()
    
    results = {
        'Total errors': int(total_errors),
        'Errors per passage': round(errors_per_passage, 1),
        'Severity': {
            'Neutral': (int(neutral), round(neutral/total_errors*100, 1)),
            'Minor': (int(minor), round(minor/total_errors*100, 1)),
            'Major': (int(major), round(major/total_errors*100, 1)),
            'Critical': (int(critical), round(critical/total_errors*100, 1))
        },
        'Error Type': {
            'Terminology': (int(terminology), round(terminology/total_errors*100, 1)),
            'Accuracy': (int(accuracy), round(accuracy/total_errors*100, 1))
        },
        'Terminology Subtypes': {
            'Term. Accuracy': (int(term_accuracy), round(term_accuracy/total_errors*100, 1)),
            'Term. Consistency': (int(term_consistency), round(term_consistency/total_errors*100, 1))
        },
        'Accuracy Subtypes': {
            'Mistranslation': (int(mistranslation), round(mistranslation/total_errors*100, 1)),
            'Overtranslation': (int(overtranslation), round(overtranslation/total_errors*100, 1)),
            'Undertranslation': (int(undertranslation), round(undertranslation/total_errors*100, 1)),
            'Addition': (int(addition), round(addition/total_errors*100, 1)),
            'Omission': (int(omission), round(omission/total_errors*100, 1))
        }
    }
    
    return results

