def print_verification(text_name, results, expected_vals):
    """Print verification results for a text"""
    print(f"\n{text_name}")
    print("-" * 90)
    
    # Total errors
    calc = results['Total errors']
    exp = expected_vals['Total errors']
    match = "✓" if calc == exp else f"✗ (expected {exp})"
    print(f"Total errors:          {calc:>4}     {match}")
    
    # Errors per passage
    calc = results['Errors per passage']
    exp = expected_vals['Errors per passage']
    match = "✓" if abs(calc - exp) < 0.1 else f"✗ (expected {exp})"
    print(f"Errors per passage:    {calc:>4.1f}     {match}")
    
    print("\nSeverity:")
    for sev in ['Neutral', 'Minor', 'Major', 'Critical']:
        count, pct = results['Severity'][sev]
        exp_count, exp_pct = expected_vals[sev]
        match_count = "✓" if count == exp_count else f"✗ ({exp_count})"
        match_pct = "✓" if abs(pct - exp_pct) < 0.2 else f"✗ ({exp_pct}%)"
        print(f"  {sev:15} {count:>4} ({pct:>5.1f}%)   Count: {match_count:>12}  Pct: {match_pct}")
    
    print("\nError Type:")
    for err_type in ['Terminology', 'Accuracy']:
        count, pct = results['Error Type'][err_type]
        exp_count, exp_pct = expected_vals[err_type]
        match_count = "✓" if count == exp_count else f"✗ ({exp_count})"
        match_pct = "✓" if abs(pct - exp_pct) < 0.2 else f"✗ ({exp_pct}%)"
        print(f"  {err_type:15} {count:>4} ({pct:>5.1f}%)   Count: {match_count:>12}  Pct: {match_pct}")
    
    print("\nTerminology Subtypes:")
    for subtype in ['Term. Accuracy', 'Term. Consistency']:
        count, pct = results['Terminology Subtypes'][subtype]
        exp_count, exp_pct = expected_vals[subtype]
        match_count = "✓" if count == exp_count else f"✗ ({exp_count})"
        match_pct = "✓" if abs(pct - exp_pct) < 0.2 else f"✗ ({exp_pct}%)"
        print(f"  {subtype:15} {count:>4} ({pct:>5.1f}%)   Count: {match_count:>12}  Pct: {match_pct}")
    
